# 忽略 Python 缓存
__pycache__/

# 忽略训练日志和结果
logs/
results/

# 忽略模型权重和隐向量数据
*.pth
*.pkl
*.mat
*.pdf
*.png
*.jpg
# Local LHS experiment outputs
results-1-LHS/
logs-LHS/
# 忽略实验结果分析
results_analysis_bundle/
result*

# Local, machine-specific repository inventory snapshots
artifacts/indexes/repository_inventory_*/
log*

# Local scientific artifacts: keep policy/readme files tracked, payloads local.
legacy_artifacts/*
!legacy_artifacts/README.md
checkpoints/*
!checkpoints/README.md
artifacts/reference/*
!artifacts/reference/README.md
